# =============================================================================
# MioFlow Vault — Template
# 复制此文件为 ~/.mio/.mioflow_vault 并填入实际值
# 此文件不包含真实密钥，可安全提交到 GitHub
# =============================================================================
#
# 各变量的作用域和服务函数如下。修改后需重新 source 生效：
#   source ~/.mio/mio-env-function
# =============================================================================


# ---------------------------------------------------------------------------
# 1. 高德地图 API Key
# 服务函数: get_map_distance (envsrc/liveEnvFunction.sh)
# 用途:     查询两地之间的驾车距离，调用高德地图开放平台 API
# 获取:     https://lbs.amap.com/ → 控制台 → 应用管理 → 创建应用
# ---------------------------------------------------------------------------
export NEBULA_AMAP_KEY=""


# ---------------------------------------------------------------------------
# 2. Materials Project API Key
# 服务函数: mp_phonon_data_extract.py (compute_lib/)
# 用途:     从 Materials Project 数据库下载声子谱和声子 DOS 数据
# 获取:     https://next-gen.materialsproject.org/ → Dashboard → API
# ---------------------------------------------------------------------------
export NEBULA_MATERIALS_PROJECT_KEY=""


# ---------------------------------------------------------------------------
# 3. HTTP 代理服务器
# 服务函数: use_agent (mio-env-function, Section 3)
# 用途:     设置 http_proxy 环境变量，通过代理访问外网
# ---------------------------------------------------------------------------
export NEBULA_HTTP_PROXY=""


# ---------------------------------------------------------------------------
# 4. 远程下载中转服务器
# 服务函数: proxy_download (mio-env-function, Section 3)
# 用途:     SSH 到该服务器执行下载命令，再将文件 scp 回本地
# 格式:     "<user>@<hostname_or_ip>"
# 备注:     需配置 SSH 密钥登录
# ---------------------------------------------------------------------------
export NEBULA_SSH_REMOTE_SERVER=""


# ---------------------------------------------------------------------------
# 5. SSH 私钥路径（用于连接远程服务器）
# 服务函数: proxy_download (mio-env-function, Section 3)
# 用途:     指定 SSH 连接时使用的私钥文件
# ---------------------------------------------------------------------------
export NEBULA_SSH_KEY_PATH="${HOME}/.ssh/id_rsa"


# ---------------------------------------------------------------------------
# 6. LaTeX 编译器路径（Windows/MiKTeX 或其它发行版）
# 服务函数: compile_tex (envsrc/liveEnvFunction.sh)
# 用途:     指定 pdflatex 和 bibtex 的完整路径（含 .exe）
# 备注:     留空则自动搜索 PATH，WSL 用户需设置 Windows 路径
# ---------------------------------------------------------------------------
export NEBULA_PDFLATEX=""
export NEBULA_BIBTEX=""
